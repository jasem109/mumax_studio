// muMAG Standard Problem #4: switching of a permalloy thin film
// Reference: http://www.ctcms.nist.gov/~rdm/mumag.org.html

SetGridSize(128, 32, 1)
SetCellSize(500e-9/128, 125e-9/32, 3e-9)

Msat  = 800e3
Aex   = 13e-12
alpha = 0.02

m = Uniform(1, .1, 0)
Relax()
Save(m)             // relaxed s-state
print("relaxed <m> =", m.average())

// field 1: reverse the magnetization
B_ext = vector(-24.6E-3, 4.3E-3, 0)
TableAdd(E_total)
TableAutoSave(10e-12)
AutoSave(m, 100e-12)
Run(1e-9)
